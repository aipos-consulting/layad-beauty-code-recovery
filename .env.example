# Browser-safe Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Supabase connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=never-commit-or-expose-this-value

# Server-only transactional email for customer verification
RESEND_API_KEY=never-commit-or-expose-this-value

# Server-only OpenAI review analysis
OPENAI_API_KEY=never-commit-or-expose-this-value
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Server-only OpenAI cost guard / Admin dashboard
# Admin Key is used only to read the official organization Costs API.
OPENAI_ADMIN_KEY=never-commit-or-expose-this-value
OPENAI_PROJECT_ID=proj_your_openai_project_id
