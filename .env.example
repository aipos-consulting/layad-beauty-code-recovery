# Browser-safe Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Supabase connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=never-commit-or-expose-this-value

# Server-only OpenAI analysis
OPENAI_API_KEY=never-commit-or-expose-this-value
OPENAI_MODEL=gpt-5-mini
# Backward-compatible alias if an older deployment still uses it
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Server-only OpenAI organization cost visibility / LAYAD Cost Guard
# Create and store these only in the deployment environment. Never expose them to the browser.
OPENAI_ADMIN_KEY=never-commit-or-expose-this-value
OPENAI_PROJECT_ID=proj_your_layad_project_id

# After changing server-side environment variables in Vercel, create a new deployment so the runtime receives the updated values.
